# Configuração de Segurança - CoinBalance CNB
# 
# IMPORTANTE: Este arquivo contém chaves sensíveis!
# NUNCA commite este arquivo no Git!
# 
# Para usar: source .env

# ========== CHAVES DE CRIPTOGRAFIA ==========
# Chave mestra para criptografia de chaves privadas (32+ bytes)
# Gere uma chave segura: openssl rand -base64 32
COINBALANCE_MASTER_KEY="$(openssl rand -base64 32)"

# Chave secreta para JWT (32+ bytes)  
# Gere uma chave segura: openssl rand -base64 32
JWT_SECRET_KEY="$(openssl rand -base64 32)"

# ========== CONFIGURAÇÕES DE SEGURANÇA ==========
# Tempo de expiração dos tokens (em minutos)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Tempo de expiração dos refresh tokens (em dias)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# ========== CONFIGURAÇÕES DE RATE LIMITING ==========
# Habilitar rate limiting
RATE_LIMIT_ENABLED=true

# Limite de requisições por minuto
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Limite de burst (requisições simultâneas)
RATE_LIMIT_BURST=20

# ========== CONFIGURAÇÕES DE LOGGING ==========
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Formato de log (json, text)
LOG_FORMAT=json

# ========== CONFIGURAÇÕES DE BANCO ==========
# Caminho do banco de dados
DATABASE_PATH=blockchain.db

# ========== CONFIGURAÇÕES DE CORS ==========
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Permitir credenciais
CORS_ALLOW_CREDENTIALS=true

# ========== CONFIGURAÇÕES DE DESENVOLVIMENTO ==========
# Habilitar documentação da API (apenas desenvolvimento)
ENABLE_API_DOCS=false

# Modo de desenvolvimento
DEBUG_MODE=false

# ========== CONFIGURAÇÕES DE PRODUÇÃO ==========
# Host da aplicação
HOST=0.0.0.0

# Porta da aplicação
PORT=8000

# ========== CONFIGURAÇÕES DE MONITORAMENTO ==========
# Habilitar métricas
ENABLE_METRICS=true

# Porta das métricas
METRICS_PORT=9090

# ========== CONFIGURAÇÕES DE BACKUP ==========
# Habilitar backup automático
ENABLE_AUTO_BACKUP=true

# Intervalo de backup (em horas)
BACKUP_INTERVAL_HOURS=24

# Diretório de backup
BACKUP_DIRECTORY=backups/
