# Configurações de Produção para CoinBalance
# ==========================================

# Configurações de Segurança
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-here-minimum-32-chars
COINBALANCE_MASTER_KEY=your-super-secure-master-key-here-minimum-32-chars

# Configurações de Banco de Dados
DATABASE_URL=sqlite:///production.db
# Para PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/coinbalance

# Configurações de Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Configurações de Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/coinbalance/app.log

# Configurações de Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# Configurações de CORS
CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true

# Configurações de Monitoramento
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics

# Configurações de Web3
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-project-id
WEB3_PRIVATE_KEY=your-web3-private-key-here

# Configurações de IA
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4

# Configurações de Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Configurações de SSL
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/coinbalance.crt
SSL_KEY_PATH=/etc/ssl/private/coinbalance.key

# Configurações de Performance
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000
TIMEOUT=30

# Configurações de Desenvolvimento (NÃO USAR EM PRODUÇÃO)
DEBUG=false
DOCS_ENABLED=false
TESTING=false
